# NVIDIA NIM API Key
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=

# NVIDIA Build chat-completions model ID.
# Default is a text-only model; endpoint availability and free-tier limits can change.
# Change this to any NVIDIA NIM chat-completions model your API key can access.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional OpenAI-compatible provider keys. The admin portal never returns keys
# to the browser; it can only select providers whose server-side key is present.
# Recommended primary: OpenAI GPT-6 Luna (cheap, fast, strong instruction following).
# AI_PROVIDER chooses the default; leave unset to auto-select the first configured provider.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Fallback: Google Gemini 3.8 Flash (OpenAI-compatible endpoint).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=low
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle

# JWT Secret — MUST be at least 32 characters long.
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-at-least-32-chars-long

# Same-origin admin console. The path can be changed, but path secrecy is not
# authentication; keep the credentials below private and use HTTPS in production.
ADMIN_PATH=/parlez-admin
# run.sh prompts for an admin username and password on first startup.
# Authenticator MFA is optional and can be enrolled from the admin panel.
# Manual alternative: python scripts/generate_admin_credentials.py --env-file .env
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=15

# Token lifetime in hours (default: 24)
TOKEN_EXPIRY_HOURS=24

# Cookie security. In production this MUST be true and the app served over HTTPS.
# For local HTTP development (http://localhost:8000), set COOKIE_SECURE=false —
# browsers REFUSE to store a Secure-flagged cookie over plain HTTP, and leaving
# it as true locally makes login appear to fail with a misleading "network error".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: Redis URL for shared rate-limit storage across serverless instances.
# If set, slowapi will use Redis instead of in-memory counters.
# Example: REDIS_URL=redis://localhost:6379/0
# Leave unset to use in-memory rate limiting (fine for single-server/local use).
REDIS_URL=

# Observability: JSON logs always go to stdout. Recent dashboard samples are
# process-local; configure OTLP/Prometheus for durable multi-worker monitoring.
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=parlez
OTEL_TRACE_SAMPLE_RATIO=1.0
# Example: http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# /metrics stays disabled unless explicitly enabled with a strong bearer token.
METRICS_ENABLED=false
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Payments — SANDBOX only for now. Do not put live keys in this file.
# Prices in payments.py are placeholders until confirmed and disclosed.
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8000

# Khalti sandbox: get a test secret key from https://test-admin.khalti.com
# Test wallet IDs: 9800000000–9800000005 · MPIN 1111 · OTP 987654
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/
KHALTI_RETURN_URL=/api/payments/return/khalti

# eSewa sandbox: product code EPAYTEST and secret 8gBm/:&EnhH.1/q are public
# test credentials. Test IDs 9806800001–5 · password Nepal@123 · MPIN 1122 · OTP 123456
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

# International (later): Paddle sandbox — Merchant of Record.
# Do not enable until sandbox prices and webhooks are configured.
PADDLE_API_KEY=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
PADDLE_BASE_URL=https://sandbox-api.paddle.com
