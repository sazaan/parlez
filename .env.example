# NVIDIA NIM API Key
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=

# NVIDIA Build chat-completions model ID.
# Default is a text-only model; endpoint availability and free-tier limits can change.
# Change this to any NVIDIA NIM chat-completions model your API key can access.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional OpenAI-compatible provider keys. The admin portal never returns keys
# to the browser; it can only select providers whose server-side key is present.
AI_PROVIDER=nvidia
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle

# JWT Secret — MUST be at least 32 characters long.
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-at-least-32-chars-long

# Same-origin admin console. The path can be changed, but path secrecy is not
# authentication; keep the credentials below private and use HTTPS in production.
ADMIN_PATH=/parlez-admin
# Generate secure values locally with: python scripts/generate_admin_credentials.py
# The console is disabled until all four authentication values are configured.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=15

# Token lifetime in hours (default: 24)
TOKEN_EXPIRY_HOURS=24

# Cookie security. In production this MUST be true and the app served over HTTPS.
# For local HTTP development (http://localhost:8000), set COOKIE_SECURE=false —
# browsers REFUSE to store a Secure-flagged cookie over plain HTTP, and leaving
# it as true locally makes login appear to fail with a misleading "network error".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: Redis URL for shared rate-limit storage across serverless instances.
# If set, slowapi will use Redis instead of in-memory counters.
# Example: REDIS_URL=redis://localhost:6379/0
# Leave unset to use in-memory rate limiting (fine for single-server/local use).
REDIS_URL=
