# NVIDIA NIM API Key
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# JWT Secret — MUST be at least 32 characters long.
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-at-least-32-chars-long

# Token lifetime in hours (default: 24)
TOKEN_EXPIRY_HOURS=24

# Cookie security. For local HTTP development only, set COOKIE_SECURE=false.
# In production this must be true and the app served over HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Optional: Redis URL for shared rate-limit storage across serverless instances.
# If set, slowapi will use Redis instead of in-memory counters.
# Example: REDIS_URL=redis://localhost:6379/0
# Leave unset to use in-memory rate limiting (fine for single-server/local use).
REDIS_URL=
