# Local backup directory (backup.py default = data/backups). The Docker
# sidecar writes to a named volume (backup_data), but if someone runs
# backup.py locally for testing, the output lands here.
backups/
data/backups/

# Kimchi workspace docs (plans, specs, verification notes) — local only
.kimchi/
